# Production pilote — copier vers backend/.env.prod (JAMAIS commité) et remplir.
# docker compose -f docker-compose.prod.yml up -d

# ── MySQL (service db + backend + backup) ────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGER-MOI-root
MYSQL_DATABASE=devis_ai
MYSQL_USER=devis
MYSQL_PASSWORD=CHANGER-MOI
MYSQL_HOST=db

# ── Backend ──────────────────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://devis:CHANGER-MOI@db:3306/devis_ai
SECRET_KEY=CHANGER-MOI-64-caracteres-aleatoires
ANTHROPIC_API_KEY=
FRONTEND_URL=https://votre-domaine.fr
# Derrière le reverse proxy TLS de l'hôte : la vraie IP client vient de X-Forwarded-For.
TRUST_PROXY_HEADERS=true

# ── E-mails (envoi des devis) ────────────────────────────────────────────────
# Resend s'utilise par son endpoint SMTP : host smtp.resend.com, user "resend",
# password = clé API. Aucun code spécifique nécessaire.
EMAIL_MODE=smtp
EMAIL_FROM=Devis AI <no-reply@votre-domaine.fr>
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=8

# ── Observabilité (optionnel : vide = désactivé) ─────────────────────────────
SENTRY_DSN=

# ── Sauvegardes (service backup) ─────────────────────────────────────────────
BACKUP_RETENTION_DAYS=14
